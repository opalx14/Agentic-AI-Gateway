# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/scripts/ui-check.mjs
/scripts/ui-debug.mjs

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local agent / project workflow metadata
/.agents/
/AGENTS.md
/.claude/
/.cursor/
/.idea/
/.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# deployment artifacts
.vercel
.open-next/
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts
