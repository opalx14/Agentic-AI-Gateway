# Dynamic embedded wallet. Enable Email OTP + Solana Devnet + embedded wallets in the Dynamic dashboard.
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

TRAVEL_PROVIDER=fixture
ATLAS_ALLOW_SANDBOX_BOOKING=false

# Atlas CLI/provider credentials are configured outside the frontend.
# Add only variables required by the actual local Atlas integration.
ATLAS_BASE_URL=
ATLAS_API_KEY=
ATLAS_CLIENT_ID=

SOLANA_DEVNET_RPC_URL=
SOLANA_DEVNET_READ_RPC_URL=
SOLANA_DEVNET_BLOCKHASH_RPC_URL=
SOLANA_DEVNET_SEND_RPC_URL=
SOLANA_DEVNET_CONFIRM_RPC_URL=
SOLANA_DEVNET_FALLBACK_RPC_URLS=
SOLANA_CLUSTER=devnet
